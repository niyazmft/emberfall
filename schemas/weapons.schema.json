{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Weapons Schema",
  "type": "object",
  "required": ["weapons"],
  "properties": {
    "weapons": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "attack_profile", "range_min", "range_max"],
        "properties": {
          "id": { "type": "string" },
          "attack_profile": {
            "type": "string",
            "enum": ["MELEE", "RANGED"]
          },
          "range_min": { "type": "integer", "minimum": 1 },
          "range_max": { "type": "integer", "minimum": 1 },
          "scaling_stat": {
            "type": "string",
            "enum": ["off", "spd"]
          }
        }
      }
    }
  }
}
