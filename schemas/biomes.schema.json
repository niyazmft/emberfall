{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Biome Definitions Schema",
  "type": "object",
  "required": ["biomes"],
  "properties": {
    "biomes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "name_key"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "name_key": { "type": "string" },
          "elevation_flavor": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "room_templates": {
            "type": "array",
            "items": { "type": "string" }
          },
          "generation_params": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cover_density": { "type": "number", "minimum": 0, "maximum": 1 },
              "elevation_min": { "type": "integer", "minimum": 0, "maximum": 2 },
              "elevation_max": { "type": "integer", "minimum": 0, "maximum": 2 },
              "blocked_density": { "type": "number", "minimum": 0, "maximum": 1 },
              "hazard_density": { "type": "number", "minimum": 0, "maximum": 1 },
              "hazard_types": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "required": ["cover_density", "elevation_min", "elevation_max", "blocked_density"]
          }
        }
      }
    }
  }
}
