{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tutorial Steps Schema",
  "description": "Definition of tutorial steps and their progression logic.",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title_key": { "type": "string" },
          "body_key": { "type": "string" },
          "trigger_event": { "type": "string" },
          "completion_event": { "type": "string" },
          "input_locks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "visual_hints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "enum": ["highlight", "arrow"] },
                "target_node": { "type": "string" },
                "position_offset": {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": ["type", "target_node"]
            }
          }
        },
        "required": ["id", "title_key", "body_key"]
      }
    }
  },
  "required": ["version", "steps"]
}
