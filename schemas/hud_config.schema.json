{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HUD Configuration Schema",
  "type": "object",
  "required": ["tooltips", "combat_log", "ap_bar", "turn_banner", "end_screens"],
  "properties": {
    "tooltips": {
      "type": "object",
      "properties": {
        "hp_bar": { "type": "string" },
        "ap_bar": { "type": "string" },
        "move_button": { "type": "string" },
        "attack_button": { "type": "string" },
        "end_turn_button": { "type": "string" }
      },
      "required": ["hp_bar", "ap_bar", "move_button", "attack_button", "end_turn_button"],
      "additionalProperties": false
    },
    "combat_log": {
      "type": "object",
      "properties": {
        "templates": {
          "type": "object",
          "properties": {
            "player_turn": { "type": "string" },
            "enemy_turn": { "type": "string" },
            "round_start": { "type": "string" },
            "select_target": { "type": "string" },
            "damage_dealt": { "type": "string" }
          },
          "required": ["player_turn", "enemy_turn", "round_start", "select_target", "damage_dealt"],
          "additionalProperties": false
        }
      },
      "required": ["templates"]
    },
    "ap_bar": {
      "type": "object",
      "properties": {
        "segment_count": { "type": "integer", "minimum": 1 },
        "pip_spacing": { "type": "number" }
      },
      "required": ["segment_count"]
    },
    "turn_banner": {
      "type": "object",
      "properties": {
        "fade_duration": { "type": "number", "minimum": 0 },
        "slide_duration": { "type": "number", "minimum": 0 },
        "display_duration": { "type": "number", "minimum": 0 }
      },
      "required": ["fade_duration", "slide_duration", "display_duration"]
    },
    "end_screens": {
      "type": "object",
      "properties": {
        "victory": {
          "type": "object",
          "properties": {
            "title_key": { "type": "string" },
            "summary_keys": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["title_key"]
        },
        "defeat": {
          "type": "object",
          "properties": {
            "title_key": { "type": "string" },
            "summary_keys": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["title_key"]
        }
      },
      "required": ["victory", "defeat"]
    }
  }
}
