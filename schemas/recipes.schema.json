{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Recipes Schema",
  "type": "object",
  "required": ["recipes"],
  "properties": {
    "recipes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "result_item_id", "ingredients"],
        "properties": {
          "id": { "type": "string" },
          "result_item_id": { "type": "string" },
          "result_quantity": { "type": "integer", "minimum": 1, "default": 1 },
          "ingredients": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          },
          "currency_costs": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
