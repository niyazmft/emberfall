{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hotbar Bindings Schema",
  "type": "object",
  "required": ["hotbar_bindings"],
  "properties": {
    "hotbar_bindings": {
      "type": "object",
      "required": ["default_layout"],
      "properties": {
        "default_layout": {
          "type": "array",
          "items": { "type": ["string", "null"] },
          "minItems": 0,
          "maxItems": 12
        }
      }
    }
  }
}
