{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Environmental Props Schema",
  "type": "object",
  "required": ["props"],
  "properties": {
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name_key", "flavor_key"],
        "properties": {
          "id": { "type": "string" },
          "name_key": { "type": "string" },
          "flavor_key": { "type": "string" },
          "interactable": { "type": "boolean", "default": true }
        }
      }
    }
  }
}
