{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tutorial Assets Schema",
  "description": "Manifest for tutorial-specific visual assets.",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "assets": {
      "type": "object",
      "properties": {
        "highlight_frame": { "type": "string" },
        "arrow_texture": { "type": "string" },
        "overlay_bg": { "type": "string" }
      },
      "required": ["highlight_frame", "arrow_texture"]
    }
  },
  "required": ["version", "assets"]
}
