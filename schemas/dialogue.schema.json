{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dialogue Data",
  "type": "object",
  "properties": {
    "dialogues": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "speaker": {
                  "type": "string",
                  "minLength": 1
                },
                "text_key": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-zA-Z0-9_.]+$"
                },
                "portrait": {
                  "type": "string"
                }
              },
              "required": [
                "speaker",
                "text_key"
              ]
            }
          },
          "next_id": {
            "type": "string"
          }
        },
        "required": [
          "lines"
        ]
      }
    }
  },
  "required": [
    "dialogues"
  ]
}
