{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Elemental Interaction Table Schema",
  "description": "Validation schema for elemental interaction rules.",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "interactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "elements": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "maxItems": 2
          },
          "reaction": { "type": "string" },
          "modifier": { "type": "string" },
          "narrative": { "type": "string" }
        },
        "required": ["elements", "reaction"]
      }
    }
  },
  "required": ["version", "interactions"]
}
