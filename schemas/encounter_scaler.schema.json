{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Encounter Scaler Schema",
  "type": "object",
  "required": ["scaling_curves"],
  "properties": {
    "scaling_curves": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["hp_multiplier", "off_multiplier", "def_multiplier"],
        "properties": {
          "hp_multiplier": { "type": "number", "minimum": 1.0 },
          "off_multiplier": { "type": "number", "minimum": 1.0 },
          "def_multiplier": { "type": "number", "minimum": 1.0 }
        }
      },
      "description": "Keys are room_index or 'biome_depth_X'"
    }
  }
}
