{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Secret Room Conditions Schema",
  "type": "object",
  "required": ["conditions"],
  "properties": {
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "predicate", "spawn_tile_id"],
        "properties": {
          "id": { "type": "string" },
          "predicate": {
            "type": "string",
            "enum": ["all_enemies_spared", "no_damage_taken", "specific_turn_count"]
          },
          "predicate_value": { "type": "integer" },
          "spawn_tile_id": { "type": "string" },
          "flavor_key": { "type": "string" }
        }
      }
    }
  }
}
