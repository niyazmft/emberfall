{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Encounter Composition Schema",
  "description": "Enemy group templates and difficulty weights per biome.",
  "type": "object",
  "properties": {
    "group_templates": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "biome_compositions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "group_id": { "type": "string" },
            "weight": { "type": "number", "minimum": 0 },
            "difficulty": { "type": "integer", "minimum": 1 }
          },
          "required": ["group_id", "weight", "difficulty"]
        }
      }
    }
  },
  "required": ["group_templates", "biome_compositions"]
}
