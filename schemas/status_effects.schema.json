{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Status Effects Schema",
  "type": "object",
  "required": ["status_effects"],
  "properties": {
    "status_effects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "name_key",
          "description_key",
          "duration",
          "potency_formula",
          "elemental_origin",
          "combat_formula_modifier"
        ],
        "properties": {
          "id": { "type": "string" },
          "name_key": { "type": "string" },
          "description_key": { "type": "string" },
          "duration": { "type": "integer", "minimum": 0 },
          "potency_formula": { "type": "string" },
          "elemental_origin": {
            "type": "string",
            "enum": ["NONE", "FIRE", "WATER", "WIND", "OIL"]
          },
          "combat_formula_modifier": {
            "type": "object",
            "properties": {
              "off_bonus": { "type": "integer" },
              "def_bonus": { "type": "integer" },
              "spd_mult": { "type": "number" },
              "damage_dealt_mult": { "type": "number" },
              "damage_taken_mult": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
