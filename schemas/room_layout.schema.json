{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Room Layout Schema",
  "description": "Schema for 12x12 grid room layouts used by the RoomLoader.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "biome": {
      "type": "string"
    },
    "size": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "enum": [12] },
        "height": { "type": "integer", "enum": [12] }
      },
      "required": ["width", "height"]
    },
    "layout": {
      "type": "object",
      "properties": {
        "elevation": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 2 },
          "minItems": 144,
          "maxItems": 144
        },
        "cover": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 2 },
          "minItems": 144,
          "maxItems": 144
        },
        "blocked": {
          "type": "array",
          "items": { "type": "boolean" },
          "minItems": 144,
          "maxItems": 144
        },
        "vision_blocked": {
          "type": "array",
          "items": { "type": "boolean" },
          "minItems": 144,
          "maxItems": 144
        }
      },
      "required": ["elevation", "cover", "blocked", "vision_blocked"]
    },
    "encounters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enemy_type": { "type": "string" },
          "count": { "type": "integer", "minimum": 1 },
          "positions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "x": { "type": "integer", "minimum": 0, "maximum": 11 },
                "y": { "type": "integer", "minimum": 0, "maximum": 11 }
              },
              "required": ["x", "y"]
            }
          }
        },
        "required": ["enemy_type", "positions"]
      }
    },
    "player_start": {
      "type": "object",
      "properties": {
        "x": { "type": "integer", "minimum": 0, "maximum": 11 },
        "y": { "type": "integer", "minimum": 0, "maximum": 11 }
      },
      "required": ["x", "y"]
    }
  },
  "required": ["id", "biome", "size", "layout", "encounters", "player_start"]
}
