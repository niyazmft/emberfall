{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Unlocks Schema",
  "type": "object",
  "required": ["unlocks"],
  "properties": {
    "unlocks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "name_key", "description_key", "cost", "effect_id", "effect_value"],
        "properties": {
          "id": { "type": "string" },
          "name_key": { "type": "string" },
          "description_key": { "type": "string" },
          "cost": { "type": "integer", "minimum": 0 },
          "effect_id": { "type": "string" },
          "effect_value": { "type": "number" }
        }
      }
    }
  }
}
