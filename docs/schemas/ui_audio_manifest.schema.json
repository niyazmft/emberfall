{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UI Audio Manifest Schema",
  "type": "object",
  "required": ["ui_audio"],
  "properties": {
    "ui_audio": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["file_path"],
        "properties": {
          "file_path": { "type": "string" },
          "volume_db": { "type": "number", "default": 0.0 },
          "pitch_scale": { "type": "number", "default": 1.0, "minimum": 0.01, "maximum": 4.0 }
        }
      }
    }
  }
}
