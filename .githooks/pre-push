#!/usr/bin/env bash
## Emberfall: Pre-Push Hook
## Runs the full local validation suite before any push to remote.
## This mirrors what GitHub Actions CI will run — catch failures locally first.
##
## Installed via: bash tools/setup_hooks.sh

set -euo pipefail

# Ensure common Homebrew/macOS bin directories are in the PATH
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

# Add Python user bin directories (for gdtoolkit installed via pip --user)
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi
for py_bin in "$HOME"/Library/Python/*/bin; do
    if [ -d "$py_bin" ]; then
        export PATH="$py_bin:$PATH"
    fi
done

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_DIR"

GODOT_BIN="${GODOT_BIN:-godot}"
GDFORMAT_BIN="${GDFORMAT_BIN:-gdformat}"
GDLINT_BIN="${GDLINT_BIN:-gdlint}"

echo ""
echo "╔══════════════════════════════════════════════╗"
echo "║   🔥 Emberfall Pre-Push Validation           ║"
echo "╚══════════════════════════════════════════════╝"

# ──────────────────────────────────────────────────
# STEP 0: GDScript Format (check then fail if dirty)
# ──────────────────────────────────────────────────
echo ""
echo "🎨 [0/4] GDScript Format Check..."
if command -v "$GDFORMAT_BIN" &>/dev/null; then
    "$GDFORMAT_BIN" scripts/ tests/ ui/ 2>&1
    if ! git diff --quiet -- '*.gd'; then
        echo ""
        echo "  ❌ GDScript files were reformatted by gdformat."
        echo "     Please stage and commit the formatted changes, then push again:"
        echo "     git add '*.gd' && git commit -m 'style(format): apply gdformat'"
        exit 1
    fi
    echo "  ✅ GDScript format OK"
else
    echo "  ⚠️  gdformat not found — install with: pip3 install gdtoolkit"
fi

# ──────────────────────────────────────────────────
# STEP 1: GDScript Lint
# ──────────────────────────────────────────────────
echo ""
echo "🔍 [1/4] GDScript Lint..."
if command -v "$GDLINT_BIN" &>/dev/null; then
    GDLINT_OUTPUT=$("$GDLINT_BIN" scripts/ tests/ ui/ 2>&1 || true)
    if echo "$GDLINT_OUTPUT" | grep -q "^ERROR"; then
        echo "$GDLINT_OUTPUT"
        echo ""
        echo "  ❌ gdlint reported errors. Fix before pushing."
        exit 1
    fi
    echo "  ✅ GDScript lint OK"
else
    echo "  ⚠️  gdlint not found — skipping"
fi

# ──────────────────────────────────────────────────
# STEP 2: Markdown Lint (check then fail if dirty)
# ──────────────────────────────────────────────────
echo ""
echo "📝 [2/4] Markdown Lint..."
MARKDOWNLINT_BIN="$(which markdownlint 2>/dev/null || echo "")"
if [ -n "$MARKDOWNLINT_BIN" ]; then
    # Auto-fix first
    "$MARKDOWNLINT_BIN" --fix '**/*.md' --ignore node_modules --ignore .git 2>/dev/null || true
    # Fail if files were changed — dev must commit the fixes
    if ! git diff --quiet -- '*.md'; then
        echo ""
        echo "  ❌ Markdown files were auto-fixed by markdownlint."
        echo "     Please stage and commit the fixes, then push again:"
        echo "     git add '*.md' && git commit -m 'style(docs): apply markdownlint fixes'"
        exit 1
    fi
    # Verify nothing unfixable remains
    if ! "$MARKDOWNLINT_BIN" '**/*.md' --ignore node_modules --ignore .git 2>/dev/null; then
        echo "  ❌ Markdown lint errors remain after auto-fix. Fix manually."
        "$MARKDOWNLINT_BIN" '**/*.md' --ignore node_modules --ignore .git 2>&1 || true
        exit 1
    fi
    echo "  ✅ Markdown lint OK"
else
    echo "  ⚠️  markdownlint not found — run: npm install -g markdownlint-cli"
fi

# ──────────────────────────────────────────────────
# STEP 3: Deterministic Math Validation (Python)
# ──────────────────────────────────────────────────
echo ""
echo "⚖️  [3/4] Deterministic Math Validation..."
python3 tests/validate_math.py
echo "  ✅ Math validation OK"

# ──────────────────────────────────────────────────
# STEP 4: Godot Editor Scan (GDScript parse errors)
# ──────────────────────────────────────────────────
echo ""
echo "🎮 [4/4] Godot Script Parse Check..."
if command -v "$GODOT_BIN" &>/dev/null; then
    touch addons/.gdignore
    "$GODOT_BIN" --headless --editor --quit --path . 2>&1 | tee tools/godot_lint.log
    rm -f addons/.gdignore
    if grep -iE "SCRIPT ERROR|Parse Error|Compile Error|hides an autoload singleton|SHADER ERROR" tools/godot_lint.log; then
        echo ""
        echo "  ❌ Godot reported script/shader errors. Fix before pushing."
        exit 1
    fi
    echo "  ✅ Godot script parse OK"
else
    echo "  ⚠️  Godot not found at '$GODOT_BIN' — skipping engine scan"
fi

echo ""
echo "╔══════════════════════════════════════════════╗"
echo "║   ✅ All checks passed — push is clean!      ║"
echo "╚══════════════════════════════════════════════╝"
echo ""
