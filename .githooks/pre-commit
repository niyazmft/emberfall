#!/usr/bin/env bash
## Emberfall: Pre-Commit Hook (fast checks only)
## Runs pre-commit framework on staged files.
## Heavy checks (Godot scan, full test suite) are in pre-push.

set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_DIR"

PRE_COMMIT_BIN="${PRE_COMMIT_BIN:-pre-commit}"

if command -v "$PRE_COMMIT_BIN" &>/dev/null; then
    echo "🔒 Running pre-commit checks on staged files..."
    "$PRE_COMMIT_BIN" run --hook-stage=pre-commit
else
    echo "⚠️  pre-commit not found — run: pip3 install pre-commit && bash tools/setup_hooks.sh"
fi
