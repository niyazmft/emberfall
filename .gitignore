# Godot 4 .gitignore
# https://github.com/github/gitignore/blob/main/Godot.gitignore

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
.mono_assembly/

# System/tool-specific
.DS_Store
*~
*.swp
*.swo

# Build artifacts
*.tmp
*.import

# Logs and Reports
*.log
tools/*.log
tests/*.json
!config/*.json

# Project Management / Protection artifacts
*_protection.json
.antigravitycli/
