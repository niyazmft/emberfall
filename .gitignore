# Godot 4 .gitignore
# https://github.com/github/gitignore/blob/main/Godot.gitignore

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
.mono_assembly/

# System/tool-specific
.DS_Store
*~
*.swp
*.swo

# Build artifacts
*.tmp
*.import
# Python-specific ignores
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env
.venv
*.egg-info/
dist/
build/
wheels/
parts/
var/
sdist/
*.egg
/docs/_build/
*.so
*.coverage
.tox/
.nox/
.hypothesis/
.pytest_cache/
.mypy_cache/
*.py[cod]
*$py.class

