{
  "BE_PHASE_A": {
    "text": "",
    "localization_key": "BE_PHASE_A"
  },
  "BE_B_FIRST_A": {
    "text": "Three keepers of their own small truths. You hold them now. That is the burden.",
    "localization_key": "BE_B_FIRST_A",
    "metadata": {
      "title": "The Holding",
      "word_count": 15,
      "emotion": "acknowledgement-of-transfer",
      "cadence_ms_estimate": 6000
    }
  },
  "BE_B_FIRST_B": {
    "text": "Three echoes, and the world is quieter for their leaving. You carry what remains.",
    "localization_key": "BE_B_FIRST_B",
    "metadata": {
      "title": "The Silence",
      "word_count": 14,
      "emotion": "absence-and-continuation",
      "cadence_ms_estimate": 5600
    }
  },
  "BE_B_FIRST_C": {
    "text": "Three bearers, each walking their own uncertain path. That path ends with you.",
    "localization_key": "BE_B_FIRST_C",
    "metadata": {
      "title": "The Cost",
      "word_count": 13,
      "emotion": "interrupted-futurity",
      "cadence_ms_estimate": 5200
    }
  },
  "BE_B_REPEAT_R1": {
    "text": "More remnants. The burden holds.",
    "localization_key": "BE_B_REPEAT_R1",
    "metadata": {
      "title": "The Addition",
      "word_count": 5,
      "emotion": "accumulation-without-elaboration",
      "cadence_ms_estimate": 2000
    }
  },
  "BE_B_REPEAT_R2": {
    "text": "More echoes. The world does not forget.",
    "localization_key": "BE_B_REPEAT_R2",
    "metadata": {
      "title": "The Doubling",
      "word_count": 8,
      "emotion": "persistent-memory",
      "cadence_ms_estimate": 3200
    }
  },
  "BE_B_TEMPLATE_FIRST": {
    "text": "{count} {collective_noun} of their own small truths. You hold them now. That is the burden.",
    "localization_key": ""
  },
  "BE_B_TEMPLATE_REPEAT": {
    "text": "{count} {collective_noun}. The burden holds.",
    "localization_key": ""
  },
  "BE_PHASE_C": {
    "text": "The memory passes into you.",
    "localization_key": "BE_PHASE_C",
    "metadata": {
      "legend_line_template": "Burden acknowledged — {run_count} spectral echo added to next encounter."
    }
  },
  "BE_PHASE_D": {
    "text": "You exhale. The embers cool.",
    "localization_key": "BE_PHASE_D"
  },
  "BE_LEGACY_ONCE": {
    "text": "The Keeper carried {count} {collective_noun}. The burden was borne.",
    "localization_key": "BE_LEGACY_ONCE",
    "metadata": {
      "trigger": "MORAL_FLAG >= 3 reached at least once in run"
    }
  },
  "BE_LEGACY_TWICE": {
    "text": "The Keeper carried {count} {collective_noun}, then more. The burden deepened.",
    "localization_key": "BE_LEGACY_TWICE",
    "metadata": {
      "trigger": "MORAL_FLAG >= 3 reached twice in same run"
    }
  },
  "BE_LEGACY_ZERO": {
    "text": "The Keeper laid down no weight. The path remained light.",
    "localization_key": "BE_LEGACY_ZERO",
    "metadata": {
      "trigger": "MORAL_FLAG = 0 at run end (all enemies spared)"
    }
  },
  "BE_CAP_0_TO_1": {
    "text": "[The world stills]",
    "localization_key": "BE_CAP_0_TO_1"
  },
  "BE_CAP_2_TO_3": {
    "text": "[The weight gathers]",
    "localization_key": "BE_CAP_2_TO_3"
  },
  "BE_CAP_2_TO_1": {
    "text": "[The memory loosens]",
    "localization_key": "BE_CAP_2_TO_1"
  },
  "BE_CAP_1_TO_0": {
    "text": "[The embers cool]",
    "localization_key": "BE_CAP_1_TO_0"
  },
  "BE_CAP_3_TO_0_EMERGENCY": {
    "text": "[The burden drops]",
    "localization_key": "BE_CAP_3_TO_0_EMERGENCY"
  },
  "BE_CAP_3_TO_0_NORMAL": {
    "text": "[The burden fades slowly]",
    "localization_key": "BE_CAP_3_TO_0_NORMAL"
  },
  "BE_CAP_CLIMB_EXPAND": {
    "text": "[The walls widen]",
    "localization_key": "BE_CAP_CLIMB_EXPAND"
  },
  "BE_CAP_CLIMB_CONVERGE": {
    "text": "[Everything converges]",
    "localization_key": "BE_CAP_CLIMB_CONVERGE"
  },
  "BE_CAP_BASS_IMPACT": {
    "text": "[Deep impact]",
    "localization_key": "BE_CAP_BASS_IMPACT"
  },
  "BE_CAP_MECH_CLANG": {
    "text": "[Mechanical clang]",
    "localization_key": "BE_CAP_MECH_CLANG"
  },
  "BE_CAP_STRESS_SWELL": {
    "text": "[Tension rising]",
    "localization_key": "BE_CAP_STRESS_SWELL"
  },
  "BE_CAP_NUMBNESS": {
    "text": "[The burden is silent]",
    "localization_key": "BE_CAP_NUMBNESS"
  }
}
