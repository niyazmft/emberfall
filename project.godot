; Engine Configuration for Project Emberfall
; Godot 4.x Project Scaffold — Deterministic Math Validation
; Issue: DON-31 A1

[application]
config/name="Emberfall"
config/version="0.1.0-sprint1"
config/description="Tactical grid combat with deterministic AP economy"
config/icon="res://assets/icons/icon.png"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.6", "Mobile")
boot_splash/show_image=false

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="mobile"
textures/canvas_textures/default_texture_filter=0

[layer_names]
2d_physics/layer_1="world"
2d_physics/layer_2="entities"
2d_physics/layer_3="ui"

[debug]
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=0
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[memory]
limits/message_queue/max_size=4096

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
SafeZoneManager="*res://scripts/autoload/safe_zone_manager.gd"
ConfigLoader="*res://scripts/autoload/config_loader.gd"
BurdenManager="*res://scripts/autoload/burden_manager.gd"
CaptionManager="*res://scripts/autoload/caption_manager.gd"
AudioMiddleware="*res://scripts/autoload/audio_middleware.gd"
BurdenCaptionDriver="*res://scripts/autoload/burden_caption_driver.gd"
BurdenEventCoordinator="*res://scripts/autoload/burden_event_coordinator.gd"
EntityLifecycle="*res://scripts/entities/entity_lifecycle.gd"
RunManager="*res://scripts/state_machine/run_manager.gd"
GridSystem="*res://scripts/autoload/grid_system.gd"
LayerManager="*res://scripts/autoload/layer_manager.gd"
LocalizationManager="*res://scripts/autoload/localization_manager.gd"
ToastManager="*res://scripts/autoload/toast_manager.gd"
FocusManager="*res://ui/framework/focus_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
InventoryManager="*res://scripts/inventory/inventory_manager.gd"
InputRouter="*res://scripts/autoload/input_router.gd"

[internationalization]

locale/fallback="en"

[physics]

2d/run_on_separate_thread=true

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/qa_agent/plugin.cfg")

