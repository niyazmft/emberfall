corner_radius_bottom_left = 2

[resource]
APOff/base_type = &"Panel"
APOff/styles/panel = SubResource("StyleBoxFlat_ap_off")
APOn/base_type = &"Panel"
APOn/styles/panel = SubResource("StyleBoxFlat_ap_on")
GhostBar/base_type = &"ProgressBar"
GhostBar/styles/background = SubResource("StyleBoxEmpty_hp")
GhostBar/styles/fill = SubResource("StyleBoxFlat_ghost_fill")
ProgressBar/styles/background = SubResource("StyleBoxFlat_hp_bg")
