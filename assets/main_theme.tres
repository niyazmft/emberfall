[resource]
default_font = ExtResource("1_470mv")
default_font_size = 16
Button/font_sizes/font_size = 16
Button/fonts/font = ExtResource("1_470mv")
Button/styles/normal = SubResource("StyleBoxTexture_btn_nml")
Button/styles/hover = SubResource("StyleBoxTexture_btn_hov")
Button/styles/pressed = SubResource("StyleBoxTexture_btn_prs")
Button/styles/focus = SubResource("StyleBoxTexture_btn_fcs")
Label/font_sizes/font_size = 16
Label/fonts/font = ExtResource("2_dyslx")
Panel/styles/panel = SubResource("StyleBoxTexture_panel")
PanelContainer/styles/panel = SubResource("StyleBoxTexture_panel")
ProgressBar/styles/background = SubResource("StyleBoxFlat_0arac")
ProgressBar/styles/fill = SubResource("StyleBoxFlat_611f8")

; --- Base Grid Constants ---
MarginContainer/constants/margin_left = 16
MarginContainer/constants/margin_top = 16
MarginContainer/constants/margin_right = 16
MarginContainer/constants/margin_bottom = 16
BoxContainer/constants/separation = 8

; --- Typography Scale ---
HeaderLabel/font_sizes/font_size = 24
HeaderLabel/fonts/font = ExtResource("1_470mv")
SubheaderLabel/font_sizes/font_size = 18
SubheaderLabel/fonts/font = ExtResource("1_470mv")
CaptionLabel/font_sizes/font_size = 10
CaptionLabel/fonts/font = ExtResource("1_470mv")

; --- Semantic Color Tokens ---
Theme/colors/accent = Color(0.9, 0.72, 0.18, 1)
Theme/colors/surface_dark = Color(0.10, 0.10, 0.15, 0.95)
Theme/colors/surface_mid = Color(0.18, 0.18, 0.24, 0.90)
Theme/colors/text_primary = Color(0.95, 0.95, 0.95, 1)
Theme/colors/text_muted = Color(0.6, 0.6, 0.6, 1)
Theme/colors/danger = Color(0.85, 0.20, 0.15, 1)

; --- Type Variations ---
DangerButton/styles/normal = SubResource("StyleBoxTexture_dng_nml")
DangerButton/styles/hover = SubResource("StyleBoxTexture_dng_hov")
DangerButton/styles/pressed = SubResource("StyleBoxTexture_dng_prs")
DangerButton/styles/focus = SubResource("StyleBoxTexture_btn_fcs")

; --- TabContainer Styling ---
TabContainer/colors/font_selected_color = Color(0.9, 0.75, 0.2, 1)
TabContainer/colors/font_unselected_color = Color(0.6, 0.6, 0.6, 1)
TabBar/font_sizes/font_size = 18
TabBar/fonts/font = ExtResource("1_470mv")
TabContainer/styles/panel = SubResource("StyleBoxTexture_panel")
TabContainer/styles/tab_selected = SubResource("StyleBoxTexture_tab_sel")
TabContainer/styles/tab_unselected = SubResource("StyleBoxTexture_tab_unsel")

; --- Button Animation Constants ---
; Stored as integer percentages * 100 for Godot Theme constant compatibility
Button/constants/hover_scale = 105
Button/constants/press_scale = 95
Button/constants/hover_duration_ms = 150
Button/constants/press_duration_ms = 50
